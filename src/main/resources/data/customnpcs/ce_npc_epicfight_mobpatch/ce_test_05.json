          "rootName": "t05_boss_guard",
          "priority": 1,
          "weight": 1,
          "maxCooldown": 120,
          "firstBehaviors": [
            {
              "behaviorName": "t05_guard",
              "conditions": [
                { "type": "combat_evolution:attack_level_contain", "levels": [1, 2, 3] }
